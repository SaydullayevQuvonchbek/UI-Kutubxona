<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivBookIconUser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_book"
            app:tint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBookTitleUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Kitob Nomi"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnBorrow"
            app:layout_constraintStart_toEndOf="@id/ivBookIconUser"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBookAuthorUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Muallif Nomi"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btnBorrow"
            app:layout_constraintStart_toEndOf="@id/ivBookIconUser"
            app:layout_constraintTop_toBottomOf="@id/tvBookTitleUser" />

        <TextView
            android:id="@+id/tvBookGenreUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="#E2E8F0"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Janr"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivBookIconUser"
            app:layout_constraintTop_toBottomOf="@id/tvBookAuthorUser" />

        <TextView
            android:id="@+id/tvBookCopiesUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/status_green_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Mavjud: 4 / 5"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvBookGenreUser"
            app:layout_constraintTop_toBottomOf="@id/tvBookAuthorUser" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_borrow"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
